{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["manifest_version", "bridge_status", "policy", "source", "records"],
  "properties": {
    "manifest_version": {"const": 1},
    "bridge_status": {"const": "evidence-only"},
    "policy": {
      "type": "object",
      "required": ["no_completeness_claim", "no_bulk_acquisition"],
      "properties": {
        "no_completeness_claim": {"const": true},
        "no_bulk_acquisition": {"const": true}
      }
    },
    "source": {
      "type": "object",
      "required": ["collection_id", "collection_slug", "record_count"],
      "properties": {
        "collection_id": {"const": "71329709"},
        "collection_slug": {"const": "nz_parliamentary_debates_hansard"},
        "record_count": {"type": "integer", "minimum": 1}
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["htid", "evidence_class", "archive_state", "source_url"],
        "properties": {
          "htid": {"type": "string", "minLength": 1},
          "evidence_class": {"enum": ["direct_inventory", "overlap", "gap_detection"]},
          "archive_state": {"enum": ["metadata_only", "public_derived_features", "public_full_text", "manual_review"]},
          "source_url": {"type": "string", "format": "uri"}
        }
      }
    },
    "no_completeness_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
